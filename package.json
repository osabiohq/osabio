{
  "name": "osabio",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "bin": {
    "osabio": "cli/osabio.ts"
  },
  "scripts": {
    "dev": "bun --watch --env-file=.env app/server.ts",
    "start": "bun run app/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/unit/",
    "test:client": "bun --config=bunfig.client.toml test app/src/client/",
    "test:acceptance": "bun --env-file=.env scripts/test-acceptance.ts",
    "eval": "evalite run evals/",
    "eval:analytics": "evalite run evals/analytics.eval.ts",
    "eval:chat": "evalite run evals/chat-agent.eval.ts",
    "eval:watch": "evalite watch evals/",
    "acceptance:auth": "bun test --concurrent --timeout=180000 --env-file=.env tests/acceptance/auth/",
    "acceptance:chat": "bun test --concurrent --timeout=180000 --env-file=.env tests/acceptance/chat/",
    "acceptance:extraction": "bun test --concurrent --timeout=180000 --env-file=.env tests/acceptance/extraction/",
    "acceptance:graph": "bun test --concurrent --timeout=180000 --env-file=.env tests/acceptance/graph/",
    "acceptance:workspace": "bun test --concurrent --timeout=180000 --env-file=.env tests/acceptance/workspace/",
    "migrate": "bun run --env-file=.env schema/migrate.ts",
    "seed": "bun run --env-file=.env schema/seed.ts",
    "build:cli": "bun build cli/osabio.ts --compile --bytecode --minify --outfile osabio"
  },
  "dependencies": {
    "@ai-sdk/devtools": "^0.0.15",
    "ai-sdk-provider-claude-code": "^3.0.0",
    "@ai-sdk/react": "^3.0.113",
    "@anthropic-ai/claude-agent-sdk": "^0.2.71",
    "@base-ui/react": "^1.3.0",
    "@better-auth/oauth-provider": "^1.5.3",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@openrouter/ai-sdk-provider": "^2.2.3",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.213.0",
    "@opentelemetry/context-async-hooks": "^2.6.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.213.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.213.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.213.0",
    "@opentelemetry/resources": "^2.6.0",
    "@opentelemetry/sdk-logs": "^0.213.0",
    "@opentelemetry/sdk-metrics": "^2.6.0",
    "@opentelemetry/sdk-trace-base": "^2.6.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@tanstack/react-router": "^1.131.24",
    "ai": "^6.0.101",
    "better-auth": "^1.5.3",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "codemirror": "^5",
    "codemirror-rego": "^1.2.3",
    "lucide-react": "^0.577.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-string": "^4.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "ollama-ai-provider": "^1.2.0",
    "react": "^19.1.1",
    "react-codemirror2": "^9.0.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "reagraph": "^4.30.8",
    "reaviz": "^16.1.2",
    "sandbox-agent": "^0.4.0",
    "shadcn": "^4.0.8",
    "surrealdb": "2.0.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.8.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.3.10",
    "@types/codemirror": "^5.60.17",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.4",
    "autoevals": "^0.0.132",
    "bun-types": "^1.3.5",
    "dotenv": "^17.3.1",
    "evalite": "^0.19.0",
    "happy-dom": "^20.8.4",
    "msw": "^2.12.14",
    "typescript": "^5.9.2",
    "vitest": "^4.0.18"
  },
  "trustedDependencies": [
    "@sandbox-agent/cli-darwin-arm64"
  ]
}
